{
  "name": "app-neuraal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:workers": "tsup --config tsup.workers.config.ts",
    "worker:summaries": "node dist/workers/summaryWorker.mjs",
    "worker:transcriptions": "node dist/workers/transcriptionWorker.mjs",
    "worker:reminders": "node dist/workers/reminderWorker.mjs",
    "monitor:queues": "tsx src/infrastructure/queue/bullBoardServer.ts",
    "openapi:emit": "tsx scripts/openapi/emit.ts",
    "openapi:types": "openapi-typescript openapi/openapi.json -o src/shared/api/openapi-types.ts",
    "openapi:generate": "pnpm openapi:emit && pnpm openapi:types",
    "db:seed:e2e": "tsx prisma/seed-e2e.ts",
    "prepare": "node -e \"process.exit(require('fs').existsSync('.git') ? 0 : 1)\" || exit 0 && husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.982.0",
    "@aws-sdk/s3-request-presigner": "^3.982.0",
    "@bull-board/api": "^6.18.0",
    "@bull-board/express": "^6.18.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "@sentry/nextjs": "^10.39.0",
    "@tanstack/react-query": "^5.90.20",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/extension-youtube": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.67.2",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "framer-motion": "^12.23.24",
    "import-in-the-middle": "^2.0.6",
    "ioredis": "^5.9.2",
    "jose": "^6.1.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.554.0",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "require-in-the-middle": "^8.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "baseline-browser-mapping": "^2.9.19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.4.0",
    "prisma": "^7.3.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "*.{ts,tsx,css,json,md}": [
      "prettier --check"
    ]
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.3"
    }
  },
  "packageManager": "pnpm@10.29.3"
}
