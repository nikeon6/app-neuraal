# =============================================================================
# Neuraal - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control!

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================
DATABASE_URL="postgresql://neuraal:neuraal_password@localhost:5432/neuraal?schema=public"

# =============================================================================
# Redis (BullMQ job queues)
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# S3/MinIO Object Storage (for attachments)
# =============================================================================
# Local development uses MinIO (S3-compatible)
# Console: http://localhost:9001
# For production: use real S3 or compatible service

S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-1"
S3_BUCKET="neuraal"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin_password"
S3_FORCE_PATH_STYLE="true"

# =============================================================================
# Attachment Quotas
# =============================================================================
MAX_ENTRY_ATTACHMENT_SIZE_BYTES="20971520"
MAX_USER_STORAGE_QUOTA_BYTES="1073741824"

# =============================================================================
# n8n Automation
# =============================================================================
# Local n8n instance for workflow automation
# UI: http://localhost:5678 (basic auth: neuraal / neuraal_password)

N8N_BASE_URL="http://localhost:5678"
N8N_REMINDER_WEBHOOK_URL="http://localhost:5678/webhook/neuraal-send-reminder"
N8N_SUMMARY_WEBHOOK_URL="http://localhost:5678/webhook/neuraal-entry-summary"
N8N_WEBHOOK_SECRET="dev_secret_change_me_in_production"

# Optional: n8n basic auth (only if n8n has basic auth enabled)
N8N_BASIC_AUTH_USER="neuraal"
N8N_BASIC_AUTH_PASSWORD="neuraal_password"

# =============================================================================
# Ollama (Local LLM)
# =============================================================================
# Local Ollama server for embeddings and OCR
# API: http://localhost:11434
# Verify: curl http://localhost:11434/api/tags
OLLAMA_BASE_URL="http://localhost:11434"

# ---------------------------------------------------------------------------
# Embedding model for auto-topic classification
# ---------------------------------------------------------------------------
# Available model presets (uncomment ONE):
#
#   Model A — nomic-embed-text-v2-moe (lightweight, 768-dim)
#     OLLAMA_EMBED_MODEL="nomic-embed-text-v2-moe:latest"
#     EMBEDDING_DIM="768"
#
#   Model B — qwen3-embedding:4b (mid-range, 2560-dim)
#     OLLAMA_EMBED_MODEL="qwen3-embedding:4b"
#     EMBEDDING_DIM="2560"
#
#   Model C — qwen3-embedding:latest / 8b (high-quality, 4096-dim)
#     OLLAMA_EMBED_MODEL="qwen3-embedding:latest"
#     EMBEDDING_DIM="4096"
#
# IMPORTANT: When switching models you must:
#   1. Update both OLLAMA_EMBED_MODEL and EMBEDDING_DIM together.
#   2. Run the migration: pnpm prisma migrate deploy
#      (this will ALTER the vector column to the new dimension).
#   3. Rebuild all topic embeddings (existing embeddings are incompatible
#      across models — call POST /api/topics/:id/embedding/rebuild for each).
# ---------------------------------------------------------------------------
OLLAMA_EMBED_MODEL="qwen3-embedding:latest"
EMBEDDING_DIM="4096"

# Similarity threshold for auto-topic assignment (0..1, higher = stricter)
# You may need to tune this when switching embedding models.
AUTO_TOPIC_THRESHOLD="0.12"

# =============================================================================
# Application Settings
# =============================================================================
# Base URL for callback URLs (n8n will POST to this).
# Use host.docker.internal so n8n (in Docker) can reach the host machine.
# In production, use the actual public URL.
APP_BASE_URL="http://host.docker.internal:3000"

# NODE_ENV="development"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Frontend API Client
# =============================================================================
# Base URL for API calls from the frontend (empty = same-origin, default).
# Only set this if the API runs on a different host/port.
NEXT_PUBLIC_API_BASE_URL=""

# Dev-only: fake user ID injected as x-user-id header.
# NEVER set in production — the header won't be sent when NODE_ENV=production.
NEXT_PUBLIC_DEV_USER_ID="user-123"

# Dev-only: explicitly enables x-user-id header fallback in getAuthUserId.
# Requires NODE_ENV !== "production". Set to "true" to enable.
ALLOW_DEV_USER_HEADER="true"

# =============================================================================
# AI Guardrails (Summary + future actions)
# =============================================================================
AI_SUMMARY_RATE_LIMIT_PER_MINUTE="5"
AI_SUMMARY_RATE_LIMIT_PER_HOUR="30"
AI_SUMMARY_MAX_ACTIVE_PER_USER="1"
AI_SUMMARY_MAX_ACTIVE_PER_ENTRY="1"
AI_SUMMARY_MAX_INPUT_CHARS="12000"
AI_SUMMARY_MONTHLY_QUOTA_REQUESTS="100"
AI_SUMMARY_MONTHLY_QUOTA_TOKENS="0"
AI_RATE_PREFIX="ai:rl"

# YouTube transcript
AI_TRANSCRIPT_RATE_LIMIT_PER_MINUTE="3"
AI_TRANSCRIPT_MAX_ACTIVE_PER_USER="1"
AI_TRANSCRIPT_MAX_ACTIVE_PER_ENTRY="1"
AI_TRANSCRIPT_MAX_INPUT_CHARS="12000"
AI_TRANSCRIPT_MONTHLY_QUOTA_REQUESTS="50"
AI_TRANSCRIPT_MONTHLY_QUOTA_TOKENS="0"

# OCR (Ollama)
AI_OCR_RATE_LIMIT_PER_MINUTE="5"
AI_OCR_MAX_ACTIVE_PER_USER="1"
AI_OCR_MAX_INPUT_BYTES="4000000"
AI_OCR_MONTHLY_QUOTA_REQUESTS="200"
AI_OCR_MONTHLY_QUOTA_TOKENS="0"

# WhatsApp reminders
AI_WHATSAPP_RATE_LIMIT_PER_MINUTE="5"
AI_WHATSAPP_MAX_ACTIVE_PER_USER="50"
AI_WHATSAPP_MAX_MESSAGE_CHARS="500"
AI_WHATSAPP_MONTHLY_QUOTA_REQUESTS="200"

# =============================================================================
# Sentry (Error Tracking)
# =============================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=""
# SENTRY_RELEASE="" # optional: git sha or version tag
# SENTRY_AUTH_TOKEN="" # optional: for source map upload

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL="debug"

# =============================================================================
# Metrics / Monitoring
# =============================================================================
# METRICS_TOKEN="" # optional: bearer token for /api/metrics
