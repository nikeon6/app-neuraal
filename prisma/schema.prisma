// Neuraal Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Topics
// ============================================================================

/// User-defined topic/category for organizing tasks.
model Topic {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String   @db.VarChar(7) // #RRGGBB format
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Embedding fields for auto-topic classification (Slice 6)
  // pgvector column: managed via raw SQL since Prisma doesn't natively support vector type
  // embedding         Unsupported("vector(768)")? — stored as SQL column, not in Prisma model
  embeddingModel    String?   @map("embedding_model") @db.VarChar(100)
  embeddingUpdatedAt DateTime? @map("embedding_updated_at")

  // Ensure unique topic names per user (case-insensitive handled in app layer)
  @@unique([userId, name])
  // Ensure unique topic colors per user (app-level check + DB safety net for races)
  @@unique([userId, color])
  @@index([userId])
  @@map("topics")
}

// ============================================================================
// Entries (Tasks + Notes)
// ============================================================================

/// Calendar entry - can be a task or a note.
model Entry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      String   @db.VarChar(10) // YYYY-MM-DD format
  type      String   @db.VarChar(10) // "task" | "note"
  title     String   @db.VarChar(120)
  content   Json     @default("{}")
  topicId   String?  @map("topic_id")
  completed Boolean? // null for notes, true/false for tasks
  version   Int      @default(1)
  sortOrder Int      @default(0) @map("sort_order") // Lower values appear first; 0 = top
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // AI-generated summary fields
  summary          String?   @db.Text
  summaryFormat    String?   @map("summary_format") @db.VarChar(10) // "markdown" | "plain"
  summaryUpdatedAt DateTime? @map("summary_updated_at")

  // AI-generated transcript fields (YouTube)
  transcriptText      String?   @map("transcript_text") @db.Text
  transcriptUpdatedAt DateTime? @map("transcript_updated_at")

  // AI-generated OCR fields
  ocrText      String?   @map("ocr_text") @db.Text
  ocrUpdatedAt DateTime? @map("ocr_updated_at")

  // Optional: reference to Topic (not enforced by FK yet since user model doesn't exist)
  // topic     Topic?   @relation(fields: [topicId], references: [id])

  @@index([userId, date])
  @@map("entries")
}

// ============================================================================
// Attachments
// ============================================================================

/// File attachment associated with an entry.
model Attachment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  entryId    String   @map("entry_id")
  storageKey String   @map("storage_key") @db.VarChar(1024)
  filename   String   @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  kind       String   @db.VarChar(10) // "inline" | "file"
  status     String   @db.VarChar(10) // "pending" | "ready" | "deleted"
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([entryId])
  @@index([userId, status])
  @@map("attachments")
}

// ============================================================================
// Reminders
// ============================================================================

/// Scheduled reminder for an entry.
model Reminder {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  entryId     String   @map("entry_id")
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz
  channel     String   @db.VarChar(20) // "whatsapp" | "email" | "push" | "sms"
  message     String?  @db.VarChar(500)
  status      String   @db.VarChar(10) // "pending" | "sent" | "canceled" | "failed"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([entryId])
  @@index([scheduledAt])
  @@index([status])
  @@index([userId, channel, status])
  @@map("reminders")
}

// ============================================================================
// Notifications
// ============================================================================

/// In-app notification for users.
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @db.VarChar(30) // "REMINDER_SENT" | "REMINDER_FAILED" | "REMINDER_CANCELED"
  title     String   @db.VarChar(100)
  message   String   @db.VarChar(500)
  status    String   @db.VarChar(10) // "unread" | "read"
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("notifications")
}

// ============================================================================
// AI Usage (Guardrails + Tracking)
// ============================================================================

enum AiActionType {
  SUMMARY
  TRANSCRIPT_YOUTUBE
  OCR_IMAGE
  REMINDER_WHATSAPP
}

/// Monthly usage per user and action (for quotas and UI).
model AiUsageMonthly {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  action       AiActionType
  monthKey     String      @map("month_key") // "2026-02"
  requestsUsed Int         @default(0) @map("requests_used")
  tokensUsed   Int         @default(0) @map("tokens_used")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([userId, action, monthKey])
  @@index([userId, monthKey])
  @@map("ai_usage_monthly")
}

/// Ledger entry per request (audit and cost tracking).
model AiUsageLedger {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  action           AiActionType
  requestId        String?  @map("request_id") // EntrySummaryRequest.id
  model            String?  @db.VarChar(100)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  costCents        Int?     @map("cost_cents")
  metaJson         Json?    @map("meta_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, action, createdAt])
  @@map("ai_usage_ledger")
}

// ============================================================================
// Entry Summary Requests
// ============================================================================

/// Tracks async summary generation requests.
model EntrySummaryRequest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  entryId   String   @map("entry_id")
  status    String   @db.VarChar(10) // "pending" | "submitted" | "done" | "failed"
  meta      Json?    // e.g. { truncated: true, maxChars: 12000 }
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([entryId])
  @@index([status])
  @@map("entry_summary_requests")
}

// ============================================================================
// Transcription Requests
// ============================================================================

/// Tracks async YouTube transcription requests.
model TranscriptionRequest {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  entryId     String    @map("entry_id")
  youtubeUrl  String    @map("youtube_url") @db.VarChar(2048)
  status      String    @db.VarChar(10) // "pending" | "submitted" | "done" | "failed"
  meta        Json?     // e.g. { truncated: true, format: "vtt" }
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  submittedAt DateTime? @map("submitted_at")
  doneAt      DateTime? @map("done_at")
  failedAt    DateTime? @map("failed_at")

  @@index([userId])
  @@index([entryId])
  @@index([status])
  @@map("transcription_requests")
}

// ============================================================================
// Stickies (persistent notes, not date-bound)
// ============================================================================

/// Persistent sticky note displayed in the Stickies section.
model Sticky {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   @db.VarChar(120)
  content     Json     @default("{}")
  version     Int      @default(1)
  sortOrder   Int      @default(0) @map("sort_order")
  columnIndex Int      @default(0) @map("column_index") // 0 = left, 1 = right
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("stickies")
}

// ============================================================================
// Users (Authentication)
// ============================================================================

/// Authenticated user account.
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  phoneNumber   String?  @map("phone_number") @db.VarChar(20)
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]

  @@map("users")
}

// ============================================================================
// Refresh Tokens
// ============================================================================

/// Long-lived refresh token for JWT rotation.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  rotatedAt    DateTime? @map("rotated_at")
  replacedById String?   @map("replaced_by_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// Password Reset Tokens (Recover MVP)
// ============================================================================

/// Token for password recovery flow.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================================
// Email Verification Tokens
// ============================================================================

/// Token for email verification on registration.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}
