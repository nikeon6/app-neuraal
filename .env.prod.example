#Neuraal - Production Environment (VPS)
ENV_FILE=.env.prod
NODE_ENV=production

# Image to deploy from GHCR
GHCR_OWNER="you username in github"
APP_IMAGE_TAG="the tag of the image you want to deploy"


# PostgreSQL
POSTGRES_DB=neuraal
POSTGRES_USER=neuraal
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://neuraal:change_me@postgres:5432/neuraal?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Auth
AUTH_JWT_SECRET=change_me_min_32_chars
AUTH_ACCESS_TTL_SECONDS=3600 #1 hour
AUTH_REFRESH_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_RESET_TTL_MINUTES=30

# App URL
APP_BASE_URL=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=

# Storage (MinIO/S3)
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-1
S3_BUCKET=neuraal
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_me
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Attachment quotas
MAX_ENTRY_ATTACHMENT_SIZE_BYTES="20971520" #20MB
MAX_USER_STORAGE_QUOTA_BYTES="1073741824" #1GB

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=https://your-n8n-domain.com/
N8N_BASE_URL=http://n8n:5678
N8N_REMINDER_WEBHOOK_URL=http://n8n:5678/webhook/neuraal-send-reminder
N8N_SUMMARY_WEBHOOK_URL=http://n8n:5678/webhook/neuraal-entry-summary
N8N_WEBHOOK_SECRET=change_me
N8N_BASIC_AUTH_USER=neuraal
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY="change_me_32chars!"

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_OCR_MODEL="glm-ocr:q8_0"
OLLAMA_EMBED_MODEL=qwen3-embedding:latest
EMBEDDING_DIM=4096
AUTO_TOPIC_THRESHOLD="0.12"

# LangSmith 
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=your_langchain_project

# Observability
LOG_LEVEL=info
METRICS_TOKEN="your_metrics_token"

#SENTRY
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn"
SENTRY_DSN="your_sentry_dsn"
SENTRY_RELEASE=manual-vps-1
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email (SMTP) 
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_ADDRESS="noreply@your_app.app"
SMTP_FROM_NAME="Your App Name"
