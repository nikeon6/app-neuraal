# Image to deploy from GHCR
ENV_FILE=.env.prod
APP_IMAGE=ghcr.io/<github-owner>/neuraal:latest
APP_PORT=3000

# PostgreSQL
POSTGRES_DB=neuraal
POSTGRES_USER=neuraal
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://neuraal:change_me@postgres:5432/neuraal?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Auth
AUTH_JWT_SECRET=change_me_min_32_chars

# App URL
APP_BASE_URL=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=

# Storage (MinIO/S3)
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-1
S3_BUCKET=neuraal
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_me
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=https://your-n8n-domain.com/
N8N_BASE_URL=http://n8n:5678
N8N_REMINDER_WEBHOOK_URL=http://n8n:5678/webhook/neuraal-send-reminder
N8N_SUMMARY_WEBHOOK_URL=http://n8n:5678/webhook/neuraal-entry-summary
N8N_WEBHOOK_SECRET=change_me
N8N_BASIC_AUTH_USER=neuraal
N8N_BASIC_AUTH_PASSWORD=change_me

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:latest
EMBEDDING_DIM=4096

# Logging
LOG_LEVEL=info
