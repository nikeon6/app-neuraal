            {
              "id": "email-body",
              "name": "body",
              "value": "={{\n  \"<div style='font-family: Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; background-color: #ffffff;'>\" +\n  \n  // CABECERA (Con tu Logo PNG)\n  \"<div style='background-color: #2D3748; padding: 20px; text-align: center; color: white;'>\" +\n    \"<h2 style='margin: 0; font-size: 22px; letter-spacing: 0.5px;'>\" +\n      \"<img src='https://your_logo.png' alt='Neuraal Logo' style='height: 32px; width: auto; vertical-align: middle; margin-right: 10px; border: none; display: inline-block;' />\" +\n      \"<span style='vertical-align: middle;'>Neuraal</span>\" +\n    \"</h2>\" +\n  \"</div>\" +\n\n  // CUERPO\n  \"<div style='padding: 30px;'>\" +\n    \n    // Texto de introducción\n    \"<p style='color: #4A5568; font-size: 16px; line-height: 1.6; margin-top: 0; margin-bottom: 25px;'>\" +\n      \"Hey! It's your Neuraal subconscious waking up to tell you something...<br><br>\" +\n      \"Just a quick nudge to remind you that it's time to focus on your scheduled task right now:\" +\n    \"</p>\" +\n    \n    // Título de la tarea\n    \"<h1 style='color: #1a202c; font-size: 24px; margin-top: 0; margin-bottom: 10px; text-align: center;'>✨ \" + $json.body.entryTitle + \" ✨</h1>\" +\n    \n    // Fecha/Hora\n    \"<p style='color: #718096; font-size: 14px; margin-top: 0; margin-bottom: 25px; border-bottom: 1px solid #edf2f7; padding-bottom: 20px; text-align: center;'>📅 <strong>Scheduled for:</strong> \" + $json.body.scheduledAt + \"</p>\" +\n\n    // Resumen (CONDICIONAL - Convirtiendo el Markdown)\n    ($json.summaryHtml ? \n      \"<div style='background-color: #F7FAFC; padding: 15px; border-radius: 6px; border-left: 4px solid #48BB78; margin-bottom: 25px;'>\" +\n      \"<p style='font-weight: bold; color: #2D3748; margin-top: 0; margin-bottom: 8px;'>📝 Summary:</p>\" +\n      \"<div style='color: #4A5568; line-height: 1.6; margin: 0; font-size: 14px;'>\" + $json.summaryHtml + \"</div>\" +\n      \"</div>\" \n    : \"\") +\n\n    // Cierre motivacional\n    \"<p style='color: #4A5568; font-size: 16px; line-height: 1.6; margin-top: 0; margin-bottom: 0; text-align: center; font-weight: bold;'>\" +\n      \"Take a deep breath and dive right in. You've got this! 💪🚀\" +\n    \"</p>\" +\n\n  \"</div>\" +\n\n  // PIE DE PÁGINA\n  \"<div style='background-color: #f7fafc; padding: 15px; text-align: center; border-top: 1px solid #e2e8f0;'>\" +\n    \"<p style='color: #a0aec0; font-size: 13px; margin: 0; font-style: italic;'>Your second brain, always on duty.</p>\" +\n  \"</div>\" +\n\n  \"</div>\"\n}}",
