    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body.entryContent;\n// Si el input es un array, tomar el primer elemento; si no, usarlo directamente\nconst doc = Array.isArray(input) ? input[0] : input;\nconst content = doc.content || [];\n\nconst texts = content\n  .filter(block => block.type === \"paragraph\" && block.content)\n  .flatMap(block =>\n    block.content\n      .filter(node => node.type === \"text\" && node.text)\n      .map(node => node.text)\n  );\n\nreturn [{\n  json: {\n    plainText: texts.join(\"\\n\")\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [416, 0],
