      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Get data from webhook input\nconst input=$('Respond to Webhook').first().json.body\n//const input = $input.first().json.body;\nconst { requestId, userId, entryId, youtubeUrl, callbackUrl } = input;\n\n// Fix: n8n runs inside Docker, so replace localhost with host.docker.internal\nconst fixedCallbackUrl = callbackUrl.replace('localhost', 'host.docker.internal');\n\n\n// Build callback body\nconst callbackBody = {\n  requestId,\n  userId,\n  entryId,\n  youtubeUrl,\n  transcription:$input.first().json.output || \"Error in transcription\"\n  \n};\n\n// Generate HMAC signature\nconst secret = $env['N8N_WEBHOOK_SECRET'] || 'dev_secret_change_me_in_production';\nconst timestamp = Date.now().toString();\nconst rawBody = JSON.stringify(callbackBody);\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(`${timestamp}.${rawBody}`)\n  .digest('hex');\n\nreturn [{\n  json: {\n    callbackUrl: fixedCallbackUrl,\n    callbackBody,\n    rawBody,\n    timestamp,\n    signature\n  }\n}];"
      },
