    "/api/automations/entry-summary/callback": {
      "post": {
        "tags": [
          "Automations"
        ],
        "summary": "Entry summary callback (from n8n)",
        "operationId": "entrySummaryCallback",
        "description": "Callback endpoint for n8n to deliver AI-generated summaries. Authenticated via HMAC signature (NOT x-user-id).",
        "security": [],
        "parameters": [
          {
            "name": "X-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix timestamp in ms used for HMAC computation"
          },
          {
            "name": "X-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "HMAC-SHA256 signature: hmac(secret, timestamp + '.' + rawBody)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestId",
                  "userId",
                  "entryId",
                  "summary",
                  "format"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "userId": {
                    "type": "string"
                  },
                  "entryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "markdown",
                      "plain"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Summary processed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "alreadyProcessed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
