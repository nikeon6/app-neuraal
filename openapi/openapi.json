{
  "openapi": "3.1.0",
  "info": {
    "title": "Neuraal API",
    "version": "0.1.0",
    "description": "Backend API for Neuraal — task/note management with AI features (summaries, auto-topic classification)."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Topics",
      "description": "User topic/category management"
    },
    {
      "name": "Entries",
      "description": "Task and note entries"
    },
    {
      "name": "Reminders",
      "description": "Scheduled reminders for entries"
    },
    {
      "name": "Notifications",
      "description": "In-app notifications"
    },
    {
      "name": "Automations",
      "description": "Webhook callbacks (HMAC-authenticated)"
    },
    {
      "name": "Embeddings",
      "description": "Vector embeddings and auto-topic classification"
    },
    {
      "name": "Attachments",
      "description": "File attachments for entries"
    }
  ],
  "components": {
    "securitySchemes": {
      "DevUserIdHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id",
        "description": "Temporary dev-only auth. Sends a fixed user ID. Will be replaced by BearerAuth (JWT) in production."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Future JWT auth (not enforced yet)."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "Resource not found"
              }
            }
          }
        }
      },
      "Topic": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "name",
          "color",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "example": "#e11d48"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Entry": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "date",
          "type",
          "title",
          "content",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2025-06-15"
          },
          "type": {
            "type": "string",
            "enum": [
              "task",
              "note"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "content": {
            "type": "object",
            "additionalProperties": true,
            "description": "TipTap/ProseMirror JSON content"
          },
          "topicId": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null for notes"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "summaryFormat": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "markdown",
              "plain",
              null
            ]
          },
          "summaryUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Reminder": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "entryId",
          "scheduledAt",
          "channel",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "email",
              "push",
              "sms"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "canceled",
              "failed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Notification": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "type",
          "title",
          "message",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "REMINDER_SENT",
              "REMINDER_FAILED",
              "REMINDER_CANCELED",
              "SUMMARY_IN_PROGRESS",
              "SUMMARY_DONE",
              "SUMMARY_FAILED"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "unread",
              "read"
            ]
          },
          "payload": {
            "type": [
              "object",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Attachment": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "entryId",
          "storageKey",
          "filename",
          "mimeType",
          "sizeBytes",
          "kind",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "storageKey": {
            "type": "string"
          },
          "filename": {
            "type": "string",
            "maxLength": 255
          },
          "mimeType": {
            "type": "string",
            "maxLength": 100
          },
          "sizeBytes": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "inline",
              "file"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "deleted"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict (duplicate or version mismatch)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Resource UUID"
      }
    }
  },
  "security": [
    {
      "DevUserIdHeader": []
    }
  ],
  "paths": {
    "/api/topics": {
      "get": {
        "tags": [
          "Topics"
        ],
        "summary": "List user topics",
        "operationId": "listTopics",
        "responses": {
          "200": {
            "description": "List of topics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "topics"
                  ],
                  "properties": {
                    "topics": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Topic"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Topics"
        ],
        "summary": "Create a topic",
        "operationId": "createTopic",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "color"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 50
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Topic created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "topic"
                  ],
                  "properties": {
                    "topic": {
                      "$ref": "#/components/schemas/Topic"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/topics/{id}": {
      "patch": {
        "tags": [
          "Topics"
        ],
        "summary": "Update a topic",
        "operationId": "updateTopic",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 50
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Topic updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "topic"
                  ],
                  "properties": {
                    "topic": {
                      "$ref": "#/components/schemas/Topic"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "delete": {
        "tags": [
          "Topics"
        ],
        "summary": "Delete a topic",
        "operationId": "deleteTopic",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "204": {
            "description": "Topic deleted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/topics/{id}/embedding/rebuild": {
      "post": {
        "tags": [
          "Embeddings"
        ],
        "summary": "Rebuild topic embedding",
        "operationId": "rebuildTopicEmbedding",
        "description": "Recalculates the embedding vector for a topic using Ollama. Useful after renaming.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Embedding rebuilt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "topicId",
                    "embeddingUpdatedAt"
                  ],
                  "properties": {
                    "topicId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "embeddingUpdatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/entries": {
      "get": {
        "tags": [
          "Entries"
        ],
        "summary": "List entries by date",
        "operationId": "listEntries",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "Date in YYYY-MM-DD format"
          }
        ],
        "responses": {
          "200": {
            "description": "List of entries for the given date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "entries"
                  ],
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Entry"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Entries"
        ],
        "summary": "Create an entry",
        "operationId": "createEntry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "date",
                  "type",
                  "title",
                  "content"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "task",
                      "note"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "content": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "topicId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "completed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Entry created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "entry"
                  ],
                  "properties": {
                    "entry": {
                      "$ref": "#/components/schemas/Entry"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/entries/{id}": {
      "patch": {
        "tags": [
          "Entries"
        ],
        "summary": "Update an entry",
        "operationId": "updateEntry",
        "description": "Updates entry fields with optimistic concurrency (version check).",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "description": "Current version for optimistic concurrency"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "content": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "topicId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "completed": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "task",
                      "note"
                    ],
                    "description": "Change entry type"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Entry updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "entry"
                  ],
                  "properties": {
                    "entry": {
                      "$ref": "#/components/schemas/Entry"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "delete": {
        "tags": [
          "Entries"
        ],
        "summary": "Delete an entry",
        "operationId": "deleteEntry",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "204": {
            "description": "Entry deleted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/entries/{id}/summarize": {
      "post": {
        "tags": [
          "Entries"
        ],
        "summary": "Request entry summary (async)",
        "operationId": "requestEntrySummary",
        "description": "Enqueues an async AI summary generation. Returns 202 Accepted.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "202": {
            "description": "Summary generation started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "requestId",
                    "notificationId",
                    "message"
                  ],
                  "properties": {
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "notificationId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/entries/{id}/auto-topic": {
      "post": {
        "tags": [
          "Embeddings"
        ],
        "summary": "Auto-assign topic to entry",
        "operationId": "autoAssignTopic",
        "description": "Generates an embedding for the entry text, finds the best matching topic by cosine similarity, and assigns it if the score meets the threshold.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Similarity threshold (default 0.35). Higher = stricter."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auto-topic result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "entryId",
                    "selectedTopicId",
                    "score"
                  ],
                  "properties": {
                    "entryId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "selectedTopicId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid"
                    },
                    "score": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Similarity score 0..1"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/reminders": {
      "post": {
        "tags": [
          "Reminders"
        ],
        "summary": "Create a reminder",
        "operationId": "createReminder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "entryId",
                  "scheduledAt",
                  "channel"
                ],
                "properties": {
                  "entryId": {
                    "type": "string",
                    "format": "uuid"
                  },
